# hf2api Environment Variables
# Copy to .env and fill in your values

# === VPN (gluetun) ===
# VPN provider: e.g., mullvad, protonvpn, windscribe
VPN_PROVIDER=
# VPN type: wireguard or openvpn
VPN_TYPE=wireguard
# WireGuard private key (required if VPN_TYPE=wireguard)
WG_PRIVATE_KEY=
# WireGuard addresses (required if VPN_TYPE=wireguard)
WG_ADDRESSES=
# VPN server city (optional filter)
VPN_CITY=

# === API Key (optional) ===
# If set, all API calls require Bearer token authentication
# API_KEY=your-secret-key

# === VITS Upstream URLs ===
# Primary REST API Space (multi-speaker, 804 voices)
# VITS_BASE_URL=https://ikechan8370-vits-uma-genshin-honkai.hf.space
# Backup REST API Spaces (tried in order on retriable failure)
# VITS_BACKUP_URL_1=https://AHJoong-vits-uma-genshin-honkai.hf.space
# VITS_BACKUP_URL_2=https://OldSecond-vits-uma-genshin-honkai.hf.space
# WebSocket fallback Space (last resort, 100 char limit)
# VITS_WS_URL=https://zomehwh-vits-uma-genshin-honkai.hf.space
# Per-character model Space (separate models per character)
# VITS_MODELS_URL=https://zomehwh-vits-models-genshin-bh3.hf.space

# === VITS Retry & Limits ===
# Maximum characters for VITS TTS input (primary: 500, WS fallback: 100)
# MAX_TEXT_LENGTH=500
# Maximum REST API retry attempts (total URLs tried)
# MAX_RETRIES=3
# Delay between retry attempts (seconds)
# RETRY_DELAY=1.0

# === Timezone ===
TZ=Asia/Taipei
