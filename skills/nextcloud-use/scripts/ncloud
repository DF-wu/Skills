    if a.action == "list":
        out_json(c.ocs("GET", base))
    elif a.action == "delete":
        out_json(c.ocs("DELETE", f"{base}/{a.id}"))
    elif a.action == "clear":
        confirm_or_die(a, "delete all notifications")
        out_json(c.ocs("DELETE", base))


def cmd_activity(c, a):
    params = {"limit": a.limit, "object_type": a.object_type, "object_id": a.object_id, "since": a.since}
    path = "/ocs/v2.php/apps/activity/api/v2/activity" + (f"/{a.filter}" if a.filter else "")
    out_json(c.ocs("GET", path, params={k: v for k, v in params.items() if v}, ok=(200, 304)))


def cmd_webhook(c, a):
    base = "/ocs/v2.php/apps/webhook_listeners/api/v1/webhooks"
    if a.action == "list":
        out_json(c.ocs("GET", base))
    elif a.action == "create":
        confirm_or_die(a, f"register a webhook that sends {a.event} events to {a.uri}")

        def _json_arg(name, raw):
            if raw is None:
                return None
            try:
                return json.loads(raw)
            except json.JSONDecodeError as e:
                die(f"--{name} must be a JSON object: {e}")

        data = {"httpMethod": a.method, "uri": a.uri, "event": a.event, "userIdFilter": a.user_filter, "authMethod": a.auth_method,
                "authData": _json_arg("auth-data", a.auth_data), "eventFilter": _json_arg("filter", a.filter), "headers": _json_arg("headers", a.headers)}
        out_json(c.ocs("POST", base, json_body={k: v for k, v in data.items() if v is not None}))
    elif a.action == "delete":
        confirm_or_die(a, f"delete webhook {a.id}")
        out_json(c.ocs("DELETE", f"{base}/{a.id}"))


# ----------------------------------------------------------------------------- commands: occ / mcp / call
# occ is deny-by-default: only these read-only commands run without --yes. Everything else changes state
# (or can, depending on arguments) and needs --yes, which the agent may only pass after the user asked for it.
OCC_READ_ONLY = frozenset("""
status check setupchecks list help app:list app:getpath
user:list user:info user:report user:lastseen user:auth-tokens:list user:keys:verify group:list group:info
config:list config:system:get config:app:get share:list
files:get files:mount:list files:reminders files:recommendations:recommend
info:file info:file:space info:storage info:storages log:tail log:watch router:list router:match
security:bruteforce:attempts security:certificates background-job:list webhook_listeners:list
taskprocessing:task:list taskprocessing:task:get taskprocessing:task:stats
fulltextsearch:check fulltextsearch:test fulltextsearch:search groupfolders:list
files_external:list files_external:backends files_external:verify files_external:dependencies
dav:list-addressbooks dav:list-calendar-shares dav:list-calendars dav:list-subscriptions
preview:queue-stats update:check twofactorauth:state integrity:check-app integrity:check-core admin-delegation:show
trashbin:size maintenance:mode
""".split())
OCC_INDEX = Path(__file__).resolve().parent.parent / "references" / "occ_commands.generated.txt"
OCC_INFO_FLAGS = {"-h", "--help", "-V", "--version"}


def occ_known_commands(c: Client | None = None) -> set[str]:
    """Full command names from the shipped index; falls back to the live `occ list` for commands added later."""
    known = set()
    if OCC_INDEX.is_file():
        known = {ln.split()[0] for ln in OCC_INDEX.read_text(encoding="utf-8").splitlines() if ln.strip()}
    if c is not None:
        r = c.occ(["list", "--format=json"])
        if r.returncode == 0:
            try:
                known |= {x["name"] for x in json.loads(r.stdout.decode("utf-8", "replace")).get("commands", [])}
            except (json.JSONDecodeError, KeyError, TypeError):
                pass
    return known


def occ_command_name(args: list[str]) -> tuple[str | None, list[str]]:
    """Skip leading global options (-n, -q, -v, --no-ansi, ...); return (command, its arguments)."""
    for i, x in enumerate(args):
        if not x.startswith("-"):
            return x, args[i + 1:]
    return None, []


def occ_is_read_only(cmd: str, rest: list[str]) -> bool:
    if cmd not in OCC_READ_ONLY:
        return False
    if cmd == "maintenance:mode":  # query form only
        return not any(x in ("--on", "--off") for x in rest)
    if cmd == "trashbin:size":  # query form only: a positional size sets it
        vals = [x for i, x in enumerate(rest) if not x.startswith("-") and not (i and rest[i - 1] in ("--user", "-u"))]
        return not vals
    if cmd == "config:list":  # --private prints passwords and secrets
        return "--private" not in rest
    return True


def cmd_occ(c, a):
    args = list(a.args)
    if args and args[0] == "--":
        args = args[1:]
    if not args:
        die("usage: ncloud occ [--yes] -- <occ-command> [args...]   (e.g. ncloud occ -- status --output=json)")
    cmd, rest = occ_command_name(args)
    if cmd is None:
        if not set(args) <= OCC_INFO_FLAGS | {"-n", "--no-interaction", "-q", "--quiet", "--no-ansi", "--ansi"}:
            die(f"no occ command in {args}")
    else:
        # Symfony accepts unambiguous abbreviations ("user:del" -> user:delete); require the full name so the guard sees it.
        if cmd not in occ_known_commands() and cmd not in occ_known_commands(c):
            die(f"'{cmd}' is not a full occ command name (abbreviations are rejected); see references/occ_commands.generated.txt "
                "or `ncloud occ -- list <namespace>`")
        if not occ_is_read_only(cmd, rest) and not a.yes:
            die(f"'{cmd}' is not on the read-only allow-list: it changes server state (or exposes secrets). "
                "Run it only when the user asked for it, then re-run with --yes")
    if a.print_only:
        print(" ".join(shlex.quote(x) for x in c.occ_argv(args)))
        return
    input_data = sys.stdin.buffer.read() if a.stdin else None
    r = c.occ(args, input_data=input_data, capture=False)
    sys.exit(r.returncode)


MCP_SECRET_NAME = "mcp-basic.b64"            # base64("user:app-password"), no newline, chmod 600


def mcp_secret_path() -> Path:
    return env_file_candidates()[0].parent / MCP_SECRET_NAME


def mcp_basic_value(c: Client) -> str:
    p = mcp_secret_path()
    if p.is_file():
        return p.read_text().strip()
    c.cfg.require_password()
    return base64.b64encode(f"{c.cfg.user}:{c.cfg.password}".encode()).decode()


def mcp_health_url(url: str) -> str:
    return url.rsplit("/mcp", 1)[0] + "/health/ready"


def mcp_secret_allowed(url: str, extra_hosts=()) -> bool:
    """The Basic secret may travel over plain http only to the local sidecar (loopback or its container name)."""
    u = urllib.parse.urlsplit(url)
    local = {"127.0.0.1", "localhost", "::1", *extra_hosts}
    return u.scheme == "https" or (u.scheme == "http" and (u.hostname or "") in local)


def mcp_create_argv(cfg: Config) -> list[str]:
    """`docker create` for the sidecar: cbcoutinho/nextcloud-mcp-server in multi_user_basic (credential pass-through)
    mode, so the container stores no Nextcloud credential and every MCP request must carry Basic auth."""
    name, port = cfg.mcp_container, cfg.mcp_port
    env = {
        "NEXTCLOUD_HOST": cfg.url,
        "MCP_DEPLOYMENT_MODE": "multi_user_basic",       # never single-user: that mode serves /mcp unauthenticated
        "NEXTCLOUD_VERIFY_SSL": "false" if cfg.insecure else "true",
        "MCP_DNS_REBINDING_PROTECTION": "true",           # reject unknown Host headers (421)
        "MCP_ALLOWED_HOSTS": f"{name}:*,127.0.0.1:*,localhost:*",
        "CORS_ALLOW_ORIGINS": f"http://127.0.0.1:{port}",  # no browser clients
        "METRICS_ENABLED": "false",
        "OTEL_SERVICE_NAME": name,
    }
    argv = ["docker", "create", "--name", name, "--init", "--restart", "no", "--stop-timeout", "15",
            "-p", f"127.0.0.1:{port}:8000", "--cap-drop", "ALL", "--read-only", "--tmpfs", "/tmp",
            "--security-opt", "no-new-privileges:true",
            "--health-cmd", "curl -fsS http://127.0.0.1:8000/health/ready", "--health-interval", "30s",
            "--health-timeout", "5s", "--health-start-period", "20s", "--health-retries", "3"]
    if cfg.mcp_network:
        argv += ["--network", cfg.mcp_network]
    for k, v in env.items():
        argv += ["-e", f"{k}={v}"]
    argv += [cfg.mcp_image, "--transport", "streamable-http", "--port", "8000"]
    for app in cfg.mcp_apps:
        argv += ["--enable-app", app]
    return argv


def cmd_mcp(c, a):
    """On-demand MCP sidecar: create once, start when an agent needs MCP, stop when done.

    The sidecar runs cbcoutinho/nextcloud-mcp-server in multi_user_basic (pass-through) mode:
    every request needs `Authorization: Basic base64(user:app-password)`; the container stores nothing.
    """
    cfg = c.cfg
    name = cfg.mcp_container
    url = a.url or c.mcp_url()
    sid = a.id
    if a.action == "credential":
        p = mcp_secret_path()
        if a.write:
            c.cfg.require_password()
            # every MCP tool call replays this secret: a wrong one means one 401 per call (bruteforce bucket) -> verify first
            c.ocs("GET", "/ocs/v2.php/cloud/user")
            write_secret(p, base64.b64encode(f"{c.cfg.user}:{c.cfg.password}".encode()).decode())
            print(f"wrote {p} (base64 of user:app-password, mode 600; verified against {c.cfg.url})")
        else:
            print(f"secret file: {p} ({'exists' if p.is_file() else 'missing; run `ncloud mcp credential --write`'})")
            print("header value: Basic <base64(user:app-password)>  (use --write, never paste it into chat)")
        return
    if a.action == "create":
        if cfg.missing():
            die(f"{', '.join(cfg.missing())} not set")
        exists = subprocess.run(c.docker_argv(["docker", "inspect", "-f", "{{.State.Status}}", name]), capture_output=True, text=True)
        if exists.returncode == 0:
            if not a.recreate:
                die(f"container {name} already exists ({exists.stdout.strip()}); `ncloud mcp start` it, or --recreate --yes")
            confirm_or_die(a, f"remove and recreate container {name}")
            subprocess.run(c.docker_argv(["docker", "rm", "-f", name]), capture_output=True)
        argv = c.docker_argv(mcp_create_argv(cfg))
        if a.print_only:
            print(" ".join(shlex.quote(x) for x in argv))
            return
        r = subprocess.run(argv, capture_output=True, text=True)
        if r.returncode != 0:
            die(f"docker create failed: {r.stderr.strip()[:400]}")
        print(f"created {name} (stopped; image {cfg.mcp_image}; 127.0.0.1:{cfg.mcp_port}"
              + (f", network {cfg.mcp_network}" if cfg.mcp_network else "") + "): `ncloud mcp start` when needed")
        return
    if a.action in ("start", "stop"):
        argv = c.docker_argv(["docker", a.action, name])
        r = subprocess.run(argv, capture_output=True, text=True)
        if r.returncode != 0:
            die(f"{' '.join(argv)} failed: {r.stderr.strip()[:300]} (first time: `ncloud mcp create`)")
        if a.action == "stop":
            print(f"stopped {name}")
            return
        health = mcp_health_url(url)
        for _ in range(60):  # cold start takes ~20s (python imports + alembic)
            try:
                st, h, body = c.request("GET", health, auth=False)
                if st == 200:
                    try:
                        mode = json.loads(body).get("checks", {}).get("auth_mode")
                    except (json.JSONDecodeError, AttributeError):
                        mode = None
                    if mode != "multi_user_basic":
                        # any other mode (e.g. single-user basic from credentials in its env) serves /mcp WITHOUT auth
                        subprocess.run(c.docker_argv(["docker", "stop", name]), capture_output=True)
                        die(f"{name} reports auth_mode={mode!r}, expected 'multi_user_basic': stopped it again. "
                            "Recreate it with `ncloud mcp create --recreate --yes` (it must not hold NEXTCLOUD_USERNAME/PASSWORD)")
                    print(f"started {name}: {body.decode('utf-8', 'replace')[:300]}")
                    print(f"mcp url: {url}")
                    return
            except NcError:
                pass
            time.sleep(1)
        die(f"{name} started but {health} did not become ready in 60s (docker logs {name})")
    if a.action == "status":
        try:
            st, h, body = c.request("GET", mcp_health_url(url), auth=False)
            print(f"health: HTTP {st} {body.decode('utf-8', 'replace')[:300]}")
        except NcError as e:
            print(f"{url}: unreachable ({e}); start it with `ncloud mcp start`")
            sys.exit(2)
        if not mcp_secret_allowed(url, (name,)):
            die(f"refusing to send the Basic secret over plain http to {url} (only 127.0.0.1/localhost/{name} or https)")
        init = {"jsonrpc": "2.0", "id": 1, "method": "initialize",
                "params": {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "ncloud", "version": VERSION}}}
        st, h, body = c.request("POST", url, data=json.dumps(init), auth=False,
                                headers={"Content-Type": "application/json", "Accept": "application/json, text/event-stream",
                                         "Authorization": "Basic " + mcp_basic_value(c)})
        text = body.decode("utf-8", "replace")
        server = ""
        for line in text.splitlines():
            if line.startswith("data:"):
                try:
                    server = json.loads(line[5:]).get("result", {}).get("serverInfo", {}).get("name", "")
                except json.JSONDecodeError:
                    pass
        print(f"initialize: HTTP {st} {h.get('content-type', '')} server={server or text[:120]!r}")
        sys.exit(0 if st == 200 else 2)
    # snippet
    secret = mcp_secret_path()
    if a.runtime == "generic":
        print(f"""# Register an HTTP (streamable) MCP server in your agent runtime, only for the task at hand:
#   url:     {url}
#   header:  Authorization: Basic <contents of {secret}>
# Prefer a runtime feature that reads the header value from that file (or an env var) at call time,
# so the secret never lands in a config file or the transcript. Unregister when done, then `ncloud mcp stop`.
# On authentication errors/401: unregister immediately (each retry is a failed login), fix the secret.
#
# read-first fallback without the sidecar (stdio, 23 tools, never deletes; needs Python >= 3.13 via uv):
#   command: uvx --from git+https://github.com/street1983nk/nextcloud-mcp-connector@v0.5.0 nc-mcp
#   env:     NC_MCP_URL={c.cfg.url}  NC_MCP_USER={c.cfg.user}  NC_MCP_APP_PASSWORD=<app password>""")
    elif a.runtime == "claude":
        print(f"""# Claude Code, session-only (the secret is never written to Claude's settings):
cat > /tmp/nextcloud-mcp.json <<'EOF'
{{"mcpServers":{{"{sid}":{{"type":"http","url":"{url}","headers":{{"Authorization":"Basic ${{NC_MCP_BASIC}}"}}}}}}}}
EOF
NC_MCP_BASIC=$(cat {secret}) claude --mcp-config /tmp/nextcloud-mcp.json --strict-mcp-config

# NOT recommended: persistent add copies the secret into Claude's settings (remove it right after the task):
#   claude mcp add --transport http --scope user {sid} {url} --header "Authorization: Basic $(cat {secret})"
#   claude mcp remove {sid} --scope user

# stdio, read-first fallback (no sidecar), also session-only (needs NEXTCLOUD_APP_PASSWORD exported):
cat > /tmp/nextcloud-mcp-ro.json <<'EOF'
{{"mcpServers":{{"{sid}-ro":{{"type":"stdio","command":"uvx","args":["--from","git+https://github.com/street1983nk/nextcloud-mcp-connector@v0.5.0","nc-mcp"],"env":{{"NC_MCP_URL":"{c.cfg.url}","NC_MCP_USER":"{c.cfg.user}","NC_MCP_APP_PASSWORD":"${{NEXTCLOUD_APP_PASSWORD}}"}}}}}}}}
EOF
claude --mcp-config /tmp/nextcloud-mcp-ro.json --strict-mcp-config""")
    elif a.runtime == "mcporter":
        print(f"""# mcporter (scripted calls; --allow-http is required for ad-hoc plain http URLs)
export NC_MCP_BASIC=$(cat {secret})
mcporter list --http-url {url} --allow-http --header "Authorization=Basic $NC_MCP_BASIC" --schema
mcporter call --http-url {url} --allow-http --header "Authorization=Basic $NC_MCP_BASIC" --tool nc_webdav_list_directory --args '{{"path":""}}' --output json

# or persist in ~/.mcporter/mcporter.json (placeholder resolved at call time), remove when done:
mcporter config add {sid} --url {url} --header 'Authorization=Basic ${{NC_MCP_BASIC}}' --scope home
mcporter call {sid}.nc_webdav_list_directory path=""
mcporter config remove {sid}""")


def cmd_call(c, a):
    path = a.path
    auth = not a.no_auth
    if urllib.parse.urlsplit(path).scheme:
        url = path
        if urllib.parse.urlsplit(url).scheme not in ("http", "https"):
            die(f"unsupported URL scheme: {url}")
        if origin_of(url) != origin_of(c.cfg.url) and auth:
            # never hand the full-account app password to another host (typo, injected instruction, ...)
            die(f"refusing to send credentials to a foreign origin ({url}); add --no-auth to send the request without Authorization")
    else:
        url = c.cfg.url + "/" + path.lstrip("/")
    if a.method.upper() == "DELETE":
        confirm_or_die(a, f"DELETE {url}")
    headers = {"OCS-APIRequest": "true"}
    for h in a.header or []:
        k, v = h.split(":", 1)
        headers[k.strip()] = v.strip()
    body = None
    if a.json_file:
        body = Path(a.json_file).read_text() if a.json_file != "-" else sys.stdin.read()
        headers.setdefault("Content-Type", "application/json")
    elif a.data:
        pairs = [tuple(d.split("=", 1)) if "=" in d else (d, "") for d in a.data]
        body = urllib.parse.urlencode(pairs)
        headers.setdefault("Content-Type", "application/x-www-form-urlencoded")
    elif a.body_file:
        body = Path(a.body_file).read_bytes() if a.body_file != "-" else sys.stdin.buffer.read()
    if a.ocs and "?" not in url and "/ocs/" in url:
        url += "?format=json"
    elif a.ocs and "/ocs/" in url and "format=" not in url:
        url += "&format=json"
    st, h, data = c.request(a.method.upper(), url, data=body, headers=headers, auth=auth)
    print(f"HTTP {st}", file=sys.stderr)
    if a.headers_out:
        for k, v in h.items():
            print(f"{k}: {v}", file=sys.stderr)
    sys.stdout.buffer.write(data if isinstance(data, bytes) else data.read())
    if isinstance(data, bytes) and not data.endswith(b"\n"):
        print()
    sys.exit(0 if st < 400 else 3)


def cmd_config(c, a):
    target = env_file_candidates()[0]  # $NEXTCLOUD_USE_ENV if set, else $XDG_CONFIG_HOME/nextcloud-use/env (~/.config fallback)
    if a.action == "path":
        print(target)
        return
    cfg = c.cfg
    if a.action == "show":
        occ_mode = c.occ_mode()
        out_json({"url": cfg.url or None, "user": cfg.user or None, "password": "set" if cfg.password else None,
                  "missing": cfg.missing(), "env_file": cfg.env_file_used, "env_error": cfg.env_error,
                  "occ_mode": occ_mode, "occ_ssh_host": cfg.occ_host, "occ_container": cfg.occ_container, "occ_command": cfg.occ_command,
                  "mcp_url": c.mcp_url(), "mcp_container": cfg.mcp_container, "mcp_network": cfg.mcp_network,
                  "notes_file": str(cfg.notes_file), "notes_present": cfg.notes_file.is_file()})
        return
    if a.action == "notes":
        if cfg.notes_file.is_file():
            sys.stdout.write(cfg.notes_file.read_text(encoding="utf-8"))
        else:
            print(f"no site notes ({cfg.notes_file}); create it to record instance-specific rules for agents", file=sys.stderr)
        return
    url, user = a.url or a.nc_url, a.user_ or a.nc_user
    if not url or not user:
        die("config init needs --url and --user (the skill ships no instance defaults)")
    if target.exists() and not a.force:
        die(f"{target} exists; use --force to overwrite")
    lines = ["# nextcloud-use settings (chmod 600; never commit)", f"NEXTCLOUD_URL={url.rstrip('/')}", f"NEXTCLOUD_USER={user}",
             f"NEXTCLOUD_APP_PASSWORD={a.app_password or '<paste an app password: Settings > Security > Devices & sessions>'}"]
    lines.append(f"NEXTCLOUD_OCC_SSH_HOST={a.occ_ssh_host}" if a.occ_ssh_host else "# NEXTCLOUD_OCC_SSH_HOST=<ssh alias of the Nextcloud host>")
    lines += ["# NEXTCLOUD_OCC_MODE=auto            # auto | local | ssh | off",
              f"# NEXTCLOUD_OCC_CONTAINER={DEFAULT_OCC_CONTAINER}",
              "# NEXTCLOUD_OCC_COMMAND=sudo -u www-data php /var/www/nextcloud/occ   # non-docker installs",
              "# NEXTCLOUD_MCP_NETWORK=<docker network shared with agent containers>"]
    write_secret(target, "\n".join(lines) + "\n")
    print(f"wrote {target} (mode 600)")


def cmd_app_password(c, a):
    """Mint an app password with occ (OCS getapppassword refuses when you are already using an app password).

    Without the login password occ still creates a token ("limited capabilities": operations that need the
    login password, e.g. server-side encryption key handling, fail; WebDAV/OCS work). To create a full token,
    run on the host:  docker exec -e NC_PASS=<login password> -u www-data nextcloud-aio-nextcloud php occ \\
                      user:auth-tokens:add <uid> --name <name> --password-from-env
    """
    uid = a.uid or c.cfg.user
    confirm_or_die(a, f"mint a new full-account app password for {uid}")
    r = c.occ(["user:auth-tokens:add", uid, "--name", a.name, "-n"], input_data=None)
    out = r.stdout.decode("utf-8", "replace")
    if r.returncode != 0:
        die((r.stderr.decode("utf-8", "replace") + out).strip() or "occ user:auth-tokens:add failed")
    lines = [ln.strip() for ln in out.splitlines() if ln.strip()]
    token = lines[-1] if lines else ""
    if a.json:
        out_json({"uid": uid, "name": a.name, "app_password": token})
    else:
        print(token)
        print("# shown once: store it in a 0600 file (ncloud config init --force --app-password ...), never in chat or git", file=sys.stderr)
        print(f"# token '{a.name}' for {uid}; list: ncloud occ -- user:auth-tokens:list {uid} --output=json ; revoke: ncloud occ --yes -- user:auth-tokens:delete {uid} <id>", file=sys.stderr)


# ----------------------------------------------------------------------------- argparse
def build_parser():
    p = argparse.ArgumentParser(prog="ncloud", description="Nextcloud CLI for agents (WebDAV + OCS + raw links + occ + MCP helpers)")
    p.add_argument("--url", dest="nc_url", help="override NEXTCLOUD_URL (before the subcommand)")
    p.add_argument("--user", dest="nc_user", help="override NEXTCLOUD_USER (before the subcommand)")
    p.add_argument("--password", dest="nc_password", help="override NEXTCLOUD_APP_PASSWORD (before the subcommand; prefer env/env file)")
    p.add_argument("--version", action="version", version=VERSION)
    sp = p.add_subparsers(dest="cmd", metavar="<command>")

    def add(name, fn, help_, **kw):
        s = sp.add_parser(name, help=help_, **kw)
        s.set_defaults(fn=fn)
        return s

    s = add("doctor", cmd_doctor, "check config, auth, sharing, WebDAV, raw app, occ"); s.add_argument("--deep", action="store_true"); s.add_argument("--json", action="store_true")
    add("whoami", cmd_whoami, "OCS /cloud/user for the configured account")
    add("status", cmd_status, "GET /status.php (no auth)")
    s = add("caps", cmd_caps, "capabilities (e.g. --section files_sharing.public)"); s.add_argument("--section"); s.add_argument("--full", action="store_true")

    s = add("ls", cmd_ls, "list a folder (PROPFIND)"); s.add_argument("path", nargs="?", default="/"); s.add_argument("--depth", default="1"); s.add_argument("-l", "--long", action="store_true"); s.add_argument("--json", action="store_true")
    s = add("tree", cmd_tree, "recursive listing"); s.add_argument("path"); s.add_argument("-l", "--long", action="store_true"); s.add_argument("--json", action="store_true")
    s = add("stat", cmd_stat, "properties of one path"); s.add_argument("path"); s.add_argument("--json", action="store_true")
    s = add("fileid", cmd_fileid, "print the fileid of a path"); s.add_argument("path")
    s = add("path", cmd_path, "print the path of a fileid"); s.add_argument("fileid")
    s = add("get", cmd_get, "download a file (stdout or file)"); s.add_argument("path"); s.add_argument("out", nargs="?")
    s = add("put", cmd_put, "upload a file (local path or - for stdin)"); s.add_argument("local"); s.add_argument("path"); s.add_argument("--no-mtime", action="store_true")
    s = add("mkdir", cmd_mkdir, "create a folder"); s.add_argument("path"); s.add_argument("-p", "--parents", action="store_true")
    s = add("rm", cmd_rm, "delete a file/folder (to trash)"); s.add_argument("path"); s.add_argument("--yes", action="store_true")
    s = add("mv", cmd_mv, "move/rename"); s.add_argument("src"); s.add_argument("dst"); s.add_argument("--overwrite", action="store_true")
    s = add("cp", cmd_cp, "copy"); s.add_argument("src"); s.add_argument("dst"); s.add_argument("--overwrite", action="store_true")
    s = add("upload-dir", cmd_upload_dir, "upload a local directory tree"); s.add_argument("local"); s.add_argument("remote"); s.add_argument("--exclude", action="append", default=[]); s.add_argument("--prune", action="store_true", help="delete remote files that are not in local (needs --yes unless --dry-run)"); s.add_argument("--dry-run", action="store_true"); s.add_argument("--yes", action="store_true")
    s = add("download-dir", cmd_download_dir, "download a folder tree"); s.add_argument("remote"); s.add_argument("local")
    s = add("search", cmd_search, "WebDAV SEARCH by name/mime/size/date"); s.add_argument("--path", default="/"); s.add_argument("--name"); s.add_argument("--mime"); s.add_argument("--min-size", type=int); s.add_argument("--max-size", type=int); s.add_argument("--after", help="RFC1123/ISO date, e.g. 2026-01-01T00:00:00Z"); s.add_argument("--files-only", action="store_true"); s.add_argument("--limit", type=int, default=50); s.add_argument("--asc", action="store_true"); s.add_argument("-l", "--long", action="store_true"); s.add_argument("--json", action="store_true")
    add("providers", cmd_providers, "unified search providers")
    s = add("usearch", cmd_usearch, "unified search (files, fulltext, contacts, calendar, deck, mail...)"); s.add_argument("term"); s.add_argument("--provider"); s.add_argument("--limit", type=int, default=10); s.add_argument("--json", action="store_true")
    s = add("trash", cmd_trash, "trash bin: list | restore <name> | delete <name> --yes | empty --yes"); s.add_argument("action", choices=["list", "restore", "delete", "empty"]); s.add_argument("name", nargs="?"); s.add_argument("--yes", action="store_true"); s.add_argument("--json", action="store_true")
    s = add("versions", cmd_versions, "file versions: list <path> | get <path> <version> | restore <path> <version>"); s.add_argument("action", choices=["list", "get", "restore"]); s.add_argument("path"); s.add_argument("version", nargs="?"); s.add_argument("--json", action="store_true")
    s = add("favorite", cmd_favorite, "favorites: list | on <path> | off <path>"); s.add_argument("action", choices=["list", "on", "off"]); s.add_argument("path", nargs="?"); s.add_argument("--json", action="store_true")

    sh = add("share", None, "shares (OCS sharing API)").add_subparsers(dest="share_cmd", metavar="<action>")
    s = sh.add_parser("list", help="list my shares"); s.set_defaults(fn=cmd_share_list); s.add_argument("--path"); s.add_argument("--subfiles", action="store_true"); s.add_argument("--prefix", help="client-side path prefix filter, e.g. /filehost/"); s.add_argument("--type", choices=list(SHARE_TYPES)); s.add_argument("--with-me", action="store_true"); s.add_argument("--json", action="store_true"); s.add_argument("--full", action="store_true")
    s = sh.add_parser("get", help="one share by id"); s.set_defaults(fn=cmd_share_get); s.add_argument("id"); s.add_argument("--full", action="store_true")
    s = sh.add_parser("create", help="create a share"); s.set_defaults(fn=cmd_share_create); s.add_argument("path"); s.add_argument("--type", default="link", choices=list(SHARE_TYPES)); s.add_argument("--with", dest="with_", help="uid / gid / email / federated id"); s.add_argument("--perm", help="1 read, 15 edit, 4 file-drop, 31 all; or ro/rw/upload/full"); s.add_argument("--password"); s.add_argument("--expire", help="YYYY-MM-DD"); s.add_argument("--label"); s.add_argument("--note"); s.add_argument("--public-upload", action="store_true"); s.add_argument("--hide-download", action="store_true"); s.add_argument("--full", action="store_true"); s.add_argument("--yes", action="store_true", help="confirm a link share that grants anonymous write/upload")
    s = sh.add_parser("update", help="update share fields"); s.set_defaults(fn=cmd_share_update); s.add_argument("id"); s.add_argument("--perm"); s.add_argument("--password"); s.add_argument("--clear-password", action="store_true"); s.add_argument("--expire"); s.add_argument("--clear-expire", action="store_true"); s.add_argument("--label"); s.add_argument("--note"); s.add_argument("--hide-download", choices=["true", "false"]); s.add_argument("--public-upload", choices=["true", "false"]); s.add_argument("--yes", action="store_true", help="confirm widening a link share (write bits, upload, no password/expiry)")
    s = sh.add_parser("delete", help="delete a share"); s.set_defaults(fn=cmd_share_delete); s.add_argument("id"); s.add_argument("--yes", action="store_true")
    s = sh.add_parser("sharees", help="look up users/groups/remotes to share with"); s.set_defaults(fn=cmd_sharees); s.add_argument("term"); s.add_argument("--item-type", default="file"); s.add_argument("--limit", type=int, default=20)

    rw = add("raw", None, "raw links (files_sharing_raw)").add_subparsers(dest="raw_cmd", metavar="<action>")
    s = rw.add_parser("get", help="raw state of a link share"); s.set_defaults(fn=cmd_raw_get); s.add_argument("share_id")
    s = rw.add_parser("enable", help="enable raw serving for a link share"); s.set_defaults(fn=cmd_raw_enable); s.add_argument("share_id"); s.add_argument("--preset", choices=list(CSP_PRESETS), help="CSP preset (site|cdn|embed|asset|locked)"); s.add_argument("--csp", help="explicit CSP string ('' clears)"); s.add_argument("--raw-only", action="store_true", help="also hide the normal /s/<token> page"); s.add_argument("--no-raw-only", action="store_true")
    s = rw.add_parser("disable", help="disable raw serving"); s.set_defaults(fn=cmd_raw_disable); s.add_argument("share_id")
    s = rw.add_parser("list", help="raw-enabled link shares of a path"); s.set_defaults(fn=cmd_raw_list); s.add_argument("path")
    s = rw.add_parser("url", help="print the raw URL of a share (+ optional sub path)"); s.set_defaults(fn=cmd_raw_url); s.add_argument("share_id"); s.add_argument("path", nargs="?")
    s = rw.add_parser("presets", help="show CSP presets"); s.set_defaults(fn=cmd_raw_presets)

    s = add("user", cmd_user, "users (admin): list|get|create|set|enable|disable|delete|groups|addgroup|rmgroup"); s.add_argument("action", choices=["list", "get", "create", "set", "enable", "disable", "delete", "groups", "addgroup", "rmgroup"]); s.add_argument("uid", nargs="?"); s.add_argument("--search"); s.add_argument("--limit", type=int, default=200); s.add_argument("--password"); s.add_argument("--display-name"); s.add_argument("--email"); s.add_argument("--quota"); s.add_argument("--group", action="append"); s.add_argument("--key"); s.add_argument("--value"); s.add_argument("--gid"); s.add_argument("--yes", action="store_true")
    s = add("group", cmd_group, "groups (admin): list|members|create|delete"); s.add_argument("action", choices=["list", "members", "create", "delete"]); s.add_argument("gid", nargs="?"); s.add_argument("--search"); s.add_argument("--yes", action="store_true")
    s = add("app", cmd_app, "apps (admin): list|info|enable|disable"); s.add_argument("action", choices=["list", "info", "enable", "disable"]); s.add_argument("appid", nargs="?"); s.add_argument("--filter", choices=["enabled", "disabled"]); s.add_argument("--yes", action="store_true")
    s = add("notifications", cmd_notifications, "notifications: list|delete <id>|clear --yes"); s.add_argument("action", choices=["list", "delete", "clear"]); s.add_argument("id", nargs="?"); s.add_argument("--yes", action="store_true")
    s = add("activity", cmd_activity, "activity stream"); s.add_argument("--filter", help="all|by|self|files|favorites|... (activity filter id)"); s.add_argument("--limit", type=int, default=30); s.add_argument("--object-type"); s.add_argument("--object-id"); s.add_argument("--since")
    s = add("webhook", cmd_webhook, "webhook_listeners (admin): list|create|delete"); s.add_argument("action", choices=["list", "create", "delete"]); s.add_argument("id", nargs="?"); s.add_argument("--uri"); s.add_argument("--event", help="e.g. OCP\\Files\\Events\\Node\\NodeWrittenEvent"); s.add_argument("--method", default="POST"); s.add_argument("--filter", help="JSON eventFilter"); s.add_argument("--user-filter"); s.add_argument("--headers", help="JSON object"); s.add_argument("--auth-method", choices=["none", "header"]); s.add_argument("--auth-data", help="JSON object"); s.add_argument("--yes", action="store_true")

    s = add("occ", cmd_occ, "run occ (local docker exec or ssh); read-only allow-list runs as is, anything else needs --yes; e.g. ncloud occ -- status --output=json"); s.add_argument("args", nargs=argparse.REMAINDER); s.add_argument("--yes", action="store_true"); s.add_argument("--stdin", action="store_true", help="forward stdin (files:put -)"); s.add_argument("--print-only", action="store_true")
    s = add("mcp", cmd_mcp, "on-demand MCP sidecar: create | start | stop | status | credential [--write] | snippet --runtime generic|claude|mcporter"); s.add_argument("action", choices=["create", "start", "stop", "status", "credential", "snippet"]); s.add_argument("--runtime", default="generic", choices=["generic", "claude", "mcporter"]); s.add_argument("--url", help="MCP endpoint (default: NEXTCLOUD_MCP_URL, else derived from the sidecar settings)"); s.add_argument("--id", default="nextcloud"); s.add_argument("--write", action="store_true", help="credential: write the base64 secret file"); s.add_argument("--recreate", action="store_true", help="create: replace an existing container (needs --yes)"); s.add_argument("--yes", action="store_true"); s.add_argument("--print-only", action="store_true", help="create: print the docker command only")
    s = add("call", cmd_call, "escape hatch: raw HTTP call with auth (-d k=v, --json FILE, --body-file FILE); foreign hosts only with --no-auth"); s.add_argument("method"); s.add_argument("path"); s.add_argument("--no-auth", action="store_true", help="send without Authorization (required for other hosts)"); s.add_argument("--yes", action="store_true", help="confirm DELETE"); s.add_argument("-d", "--data", action="append"); s.add_argument("--json", dest="json_file"); s.add_argument("--body-file"); s.add_argument("-H", "--header", action="append"); s.add_argument("--no-ocs", dest="ocs", action="store_false"); s.add_argument("-i", "--headers-out", action="store_true")
    s = add("config", cmd_config, "settings file: init --url --user [--app-password --occ-ssh-host] | path | show | notes"); s.add_argument("action", choices=["init", "path", "show", "notes"]); s.add_argument("--url"); s.add_argument("--user", dest="user_"); s.add_argument("--app-password"); s.add_argument("--occ-ssh-host"); s.add_argument("--force", action="store_true")
    s = add("app-password", cmd_app_password, "mint a new app password via occ user:auth-tokens:add (no login password needed; needs --yes)"); s.add_argument("name"); s.add_argument("--uid"); s.add_argument("--json", action="store_true"); s.add_argument("--yes", action="store_true")
    return p


def main(argv=None):
    parser = build_parser()
    a = parser.parse_args(argv)
    if not getattr(a, "fn", None):
        parser.print_help()
        return 0
    cfg = Config(a)
    if cfg.env_error and a.fn not in (cmd_config, cmd_doctor):
        die(cfg.env_error, 2)
    if cfg.missing() and a.fn not in (cmd_config, cmd_doctor, cmd_mcp, cmd_occ):
        die(f"{', '.join(cfg.missing())} not set: export it or run `ncloud config init --url ... --user ...` ({env_file_candidates()[0]})", 2)
    c = Client(cfg)
    try:
        a.fn(c, a)
    except NcError as e:
        print(f"error: {e}", file=sys.stderr)
        if e.status == 401:
            print("hint: 401 -> wrong/revoked app password, or bruteforce throttling (check `ncloud occ security:bruteforce:attempts <ip>`)", file=sys.stderr)
        elif e.status == 503:
            print("hint: 503 -> maintenance mode? `ncloud occ maintenance:mode`", file=sys.stderr)
        return 3
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
